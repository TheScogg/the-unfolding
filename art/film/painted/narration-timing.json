    "text": "Stars. Worlds. Life."
  },
  {
    "start": 25.3,
    "end": 27.275145833333333,
    "text": "Did the giver survive the gift?"
  },
  {
    "start": 30,
    "end": 31.9168125,
    "text": "We keep the question open."
  },
  {
    "start": 34.2,
    "end": 36.0239375,
    "text": "We carry the gift forward."
  }
